# ── DeepSeek ─────────────────────────────────────────────
# 去 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI (用于 gpt-image-1 图片生成) ───────────────────
# 去 https://platform.openai.com/ 获取
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Drive ──────────────────────────────────────────
# 打开 Google Drive → 目标文件夹 → 地址栏最后一段就是 folder ID
# 例：https://drive.google.com/drive/folders/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs
GOOGLE_DRIVE_FOLDER_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs

# ── Google Service Account ────────────────────────────────
# 两种方式选一种：
#
# 方式 A：填写 JSON 文件的路径（推荐本地开发用）
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
#
# 方式 B：把整个 JSON 内容直接粘贴进来（推荐部署到服务器用）
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
